# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# The anon key is safe to expose client-side (it's what Row Level Security is for).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe itself needs no client-side key: Checkout Sessions are created by the
# create-checkout-session Edge Function and the browser is redirected to the
# hosted Stripe URL it returns. The Stripe secret key, Price IDs, and webhook
# signing secret all live server-side only, as Supabase Edge Function secrets —
# see SETUP.md.
